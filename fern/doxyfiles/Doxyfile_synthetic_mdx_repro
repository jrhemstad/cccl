PROJECT_NAME           = synthetic-mdx-repro
CREATE_SUBDIRS         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Paths are relative to CCCL repo root.
INPUT                  = fern/reproducers/synthetic-mdx/lib/include
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp
EXTENSION_MAPPING      = cuh=C++ cu=C++

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_INCLUDE_FILES     = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = fern/reproducers/synthetic-mdx/lib

JAVADOC_AUTOBRIEF      = YES
INHERIT_DOCS           = YES
TAB_SIZE               = 4
BUILTIN_STL_SUPPORT    = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
SKIP_FUNCTION_MACROS   = YES

QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
